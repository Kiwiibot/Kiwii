{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": {
        "type": "object",
        "properties": {
            "description": {
                "type": "string"
            },
            "usage": {
                "type": "string"
            },
            "examples": {
                "type": "object",
                "properties": {
                    "usages": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "descriptions": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "usages",
                    "descriptions"
                ]
            }
        },
        "required": [
            "description",
            "usage",
            "examples"
        ]
    }
}